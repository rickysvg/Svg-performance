  performedAt     DateTime
  sitReachValue   Float?
  sitReachUnit    String   @default("")
  sitReachLevel   String   @default("")
  frontSplitLeft  Float?
  frontSplitRight Float?
  sideSplit       Float?
  lengthUnit      String   @default("cm")
  hipLeft         Int?
  hipRight        Int?
  ankleLeft       Float?
  ankleRight      Float?
  kickFrontLeft   String   @default("")
  kickFrontRight  String   @default("")
  kickSideLeft    String   @default("")
  kickSideRight   String   @default("")
  shoulderGap     Float?
  painFlag        Boolean  @default(false)
  notes           String   @default("")
  createdAt       DateTime @default(now())

  @@index([userId, performedAt])
}

model ReadinessCheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey    String
  sleep     Int
  soreness  Int
  energy    Int
  restingHr Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayKey])
}

model TestingResult {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  performedAt      DateTime
  weekIndex        Int
  broadJumpValue   Float?
  broadJumpUnit    String   @default("")
  strengthExercise String   @default("")
  strengthLoad     Float?
  strengthReps     Int?
  strengthUnit     String   @default("lb")
  strengthEstimate Float?
  bikeSprintValue  Float?
  bikeSprintUnit   String   @default("")
  bikeFiveMinValue Float?
  bikeFiveMinUnit  String   @default("")
  restingHr        Int?
  notes            String   @default("")
  createdAt        DateTime @default(now())

  @@index([userId, performedAt])
}

model FightCamp {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Civil date YYYY-MM-DD. Not a timestamp, so the fight day does not shift across zones. */
  fightDateKey  String
  weightClass   String    @default("")
  discipline    String    @default("")
  /** Frozen at save: 12, 8, or 6. Week math counts back from the fight date. */
  templateWeeks Int
  status        String    @default("active")
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FormCheck {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movement        String
  note            String    @default("")
  /** submitted | in_review | reviewed */
  status          String    @default("submitted")
  /** local filename or private blob URL. Never sent to the browser. */
  storageKey      String
  /** local | blob */
  storageKind     String    @default("local")
  mimeType        String
  byteSize        Int
  durationSeconds Int
  feedback        String    @default("")
  reviewerUserId  String    @default("")
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  feedbackSeenAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
}

/** Hashed Gymdesk roster. Never stores plaintext email/phone for people without app accounts. */
model GymdeskMember {
  id              String    @id @default(cuid())
  gymdeskId       String    @unique
  emailHash       String    @default("")
  email2Hash      String    @default("")
  phoneHash       String    @default("")
  phone2Hash      String    @default("")
  nameKey         String    @default("")
  displayLabel    String    @default("")
  membershipLabel String    @default("")
  /** active | frozen | canceled | visitor | pending */
  status          String    @default("pending")
  statusChangedAt DateTime?
  frozenSince     DateTime?
  lastSeenAt      DateTime  @default(now())
  /** webhook | csv */
  source          String    @default("webhook")
  linkedUserId    String?
  linkedUser      User?     @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([emailHash])
  @@index([email2Hash])
  @@index([phoneHash])
  @@index([phone2Hash])
  @@index([nameKey])
  @@index([status])
  @@index([linkedUserId])
}

model GymMembershipEvent {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  from   String   @default("")
  to     String   @default("")
  reason String   @default("")
  source String   @default("")
  at     DateTime @default(now())

  @@index([userId, at])
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model GymdeskMatchQueue {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymdeskMemberId String    @default("")
  /** suggested | conflict */
  kind            String
  reason          String    @default("")
  /** open | approved | dismissed */
  status          String    @default("open")
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String    @default("")

  @@index([status, createdAt])
  @@index([userId])
}

model GymdeskSyncMeta {
  id    String   @id @default(cuid())
  key   String   @unique
  value String   @default("")
  at    DateTime @default(now())
}

model GymdeskRateLimit {
  id        String   @id @default(cuid())
  keyHash   String
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
}
