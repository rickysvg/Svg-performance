// Laptop / tests: SQLite. Hosted preview: scripts/prisma-prepare.mjs copies this
// file to schema.postgres.prisma when DATABASE_URL starts with postgresql://.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                String               @default("member")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             Profile?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  workoutSessions     WorkoutSession[]
  nutritionEntries    NutritionEntry[]
  savedMeals          SavedMeal[]
  lessonProgress      LessonProgress[]
  chatThreads              ChatThread[]
  subscriptions            Subscription[]
  reminderPrefs            ReminderPrefs?
  coachAssignmentsAsCoach  CoachAssignment[] @relation("CoachAssignments")
  coachAssignmentsAsMember CoachAssignment[] @relation("MemberAssignments")
  helpRequests             HelpRequest[]
  metricEvents             MetricEvent[]
  bodyMetrics              BodyMetric[]
  bodyPhotoPlaceholders    BodyPhotoPlaceholder[]
  progressPhotos           ProgressPhoto[]
  coachingCredits          CoachingCredit[]
  planWaitlist             PlanWaitlist[]
  bookingRequests          BookingRequest[]
  pathEnrollments          PathEnrollment[]
  pathCompletions          PathStepCompletion[]
  journalEntries           JournalEntry[]
  weeklyComments           WeeklyCoachComment[]
  coachingAdjustments      CoachingAdjustment[]
  polarConnection          PolarConnection?
  hrRestingSamples         HrRestingSample[]
  hrWorkoutSessions        HrWorkoutSession[]
  pilotInvitesCreated      PilotInvite[]          @relation("InviteAuthor")
  trainingClips            TrainingClip[]
  clipNotesAuthored        ClipTimestampNote[]    @relation("ClipNoteAuthor")
  challengeEnrollments     ChallengeEnrollment[]
  groceryLists             GroceryList[]
  weeklyFocusAuthored      WeeklyFocusVideo[]     @relation("FocusAuthor")
  exerciseNotes            ExerciseNote[]
  mobilitySessions         MobilitySession[]
  mobilityCheckIns         MobilityCheckIn[]
  readinessCheckIns        ReadinessCheckIn[]
  testingResults           TestingResult[]
  fightCamp                FightCamp?
  formChecks               FormCheck[]
  gymdeskMembers           GymdeskMember[]
  gymMembershipEvents      GymMembershipEvent[]
  emailVerificationCodes   EmailVerificationCode[]
  gymdeskMatchQueue        GymdeskMatchQueue[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  // 1 = links issued before the production leak fix. Those rows are deleted.
  // New links are stored as generation 2 with a different hash.
  generation Int       @default(1)

  @@index([userId])
}

model PasswordResetAttempt {
  id        String   @id @default(cuid())
  keyHash   String
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
}

model Profile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName            String   @default("")
  isAdultConfirmed       Boolean  @default(false)
  claimsGymMembership    Boolean  @default(false)
  gymMembershipVerified  Boolean  @default(false)
  phoneE164              String    @default("")
  emailVerifiedAt        DateTime?
  gymdeskMemberId        String    @default("")
  gymMembershipSource    String    @default("")
  gymdeskStatus          String    @default("")
  gymdeskCheckedAt       DateTime?
  gymMembershipGraceUntil DateTime?
  gymMembershipOverride  String    @default("none")
  gymMembershipOverrideNote String @default("")
  gymMembershipOverrideBy   String @default("")
  goals                  String    @default("")
  goalKey                String    @default("")
  experienceLevel        String    @default("beginner")
  primaryFocus           String    @default("")
  equipmentJson          String    @default("[]")
  weeklyAvailabilityJson String    @default("[]")
  hoursPerWeek           Int?
  sessionsPerWeek        Int?
  preferredUnits         String    @default("lb")
  timeZone               String    @default("")
  leaderboardOptIn       Boolean  @default(false)
  seenBadgeUnlocksJson   String   @default("[]")
  foodPreferences        String    @default("")
  allergies              String    @default("")
  trainingLimitations        String    @default("")
  onboardingCompletedAt      DateTime?
  onboardingDeepCompletedAt  DateTime?
  trialStartedAt             DateTime?
  trialEndsAt                DateTime?
  planChoiceAt               DateTime?
  thirdWorkoutCardDismissedAt DateTime?
  currentWeight              Float?
  goalWeight                 Float?
  sessionLengthMin           Int?
  trainingLocation           String    @default("")
  competitionStatus          String    @default("")
  nextFightDate              DateTime?
  coachingTone               String    @default("")
  /** balanced | striker | grappler — accessory emphasis, not a fight camp. */
  trainingEmphasis           String    @default("balanced")
  obstaclesJson              String    @default("[]")
  calorieTarget          Int      @default(2200)
  proteinTargetG         Int      @default(140)
  carbsTargetG           Int      @default(220)
  fatTargetG             Int      @default(70)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Program {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String
  isDemo      Boolean      @default(true)
  days        ProgramDay[]
}

model ProgramDay {
  id              String            @id @default(cuid())
  programId       String
  program         Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayNumber       Int
  title           String
  focus           String
  exercises       ProgramExercise[]
  workoutSessions WorkoutSession[]

  @@unique([programId, dayNumber])
}

model ProgramExercise {
  id           String     @id @default(cuid())
  programDayId String
  day          ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  sortOrder    Int
  name         String
  sets         Int
  reps         String
  loadText     String
  restSeconds      Int
  notes            String  @default("")
  formVideoUrl     String  @default("")
  formVideoPending Boolean @default(false)
  /** load_reps | load_timed | reps_only | timed | timed_round */
  logMode          String  @default("load_reps")
}

model WorkoutSession {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  programDayId String?
  programDay   ProgramDay? @relation(fields: [programDayId], references: [id], onDelete: SetNull)
  title        String
  performedAt  DateTime
  notes        String      @default("")
  status       String      @default("complete")
  difficultyRating String  @default("")
  /** Exercise whose between-set rest is running. Empty when rest is idle. */
  restExerciseName String   @default("")
  /** Absolute end time so a reload can resume the countdown. */
  restEndsAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sets         WorkoutSet[]
  hrLogs       HrWorkoutSession[]

  @@index([userId, performedAt])
}

model WorkoutSet {
  id               String         @id @default(cuid())
  workoutSessionId String
  session          WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseName     String
  setNumber        Int
  sortOrder        Int            @default(0)
  reps             Int?
  loadValue        Float?
  loadUnit         String         @default("lb")
  /** load_reps | load_timed | reps_only | timed | timed_round */
  logMode          String         @default("load_reps")
  durationSeconds  Int?
  completed        Boolean        @default(true)
  notes            String         @default("")
  /** Program day + exercise + rep scheme. A 5×5 day does not share history with 8–12. */
  prescriptionKey  String         @default("")
  /** Stored effort cue from the prescription, when the set had one. */
  rir              String         @default("")

  @@index([workoutSessionId])
}

model ExerciseNote {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseName String
  programDayId String   @default("")
  body         String   @default("")
  aiReply      String   @default("")
  aiOffline    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, exerciseName, programDayId])
  @@index([userId, programDayId])
}

model NutritionEntry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedMealId  String?
  savedMeal    SavedMeal? @relation(fields: [savedMealId], references: [id], onDelete: SetNull)
  eatenAt      DateTime
  mealType     String
  name         String
  servings     Float     @default(1)
  servingLabel String    @default("serving")
  calories     Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  notes        String    @default("")
  source       String    @default("manual_estimate")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, eatenAt])
}

model SavedMeal {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  servingLabel    String            @default("serving")
  calories        Float
  proteinG        Float
  carbsG          Float
  fatG            Float
  ingredientsJson String            @default("[]")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  entries         NutritionEntry[]

  @@index([userId])
}

model Lesson {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  summary          String
  skillLevel       String
  topic            String
  coachName        String
  equipment        String           @default("")
  notes                  String           @default("")
  technicalDescription   String           @default("")
  drills                 String           @default("")
  keyDetails             String           @default("")
  youtubeUrl       String           @default("")
  videoPending     Boolean          @default(false)
  supervisedNote   String           @default("")
  needsSupervision Boolean          @default(false)
  status           String           @default("draft")
  isDemo           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  progress         LessonProgress[]
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  bookmarked  Boolean   @default(false)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String        @default("")
  art       String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
  @@index([userId, topic, art])
}

model ChatMessage {
  id             String     @id @default(cuid())
  threadId       String
  thread         ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role           String
  content        String
  refused        Boolean    @default(false)
  refusalCode    String     @default("")
  offline        Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@index([threadId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String
  status               String   @default("incomplete")
  stripeCustomerId     String   @default("")
  stripeSubscriptionId String   @default("")
  stripePriceId        String   @default("")
  currentPeriodEnd     DateTime?
  source               String   @default("webhook")
