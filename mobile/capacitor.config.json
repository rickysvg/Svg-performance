{
  "appId": "app.svgperformance",
  "appName": "SVG Performance",
  "webDir": "www",
  "backgroundColor": "#000000",
  "server": {
    "url": "https://svgperformance.app",
    "cleartext": false,
    "allowNavigation": [
      "svgperformance.app",
      "www.svgperformance.app"
    ],
    "errorPath": "offline.html",
    "appStartPath": "/home"
  },
  "ios": {
    "appendUserAgent": "SVGPerformanceApp/1 (ios)",
    "contentInset": "never",
    "backgroundColor": "#000000",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "appendUserAgent": "SVGPerformanceApp/1 (android)",
    "backgroundColor": "#000000",
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#000000",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#000000"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
