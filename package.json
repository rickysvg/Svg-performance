{
  "name": "svg-performance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-prepare.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "node scripts/setup-env.mjs && node scripts/prisma-prepare.mjs --deploy && npx tsx prisma/seed.ts",
    "db:setup": "node scripts/prisma-prepare.mjs --deploy && npx tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:seed": "node scripts/prisma-seed.mjs",
    "db:deploy": "node scripts/prisma-prepare.mjs --deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "staff:promote": "tsx scripts/promote-role.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "bcryptjs": "^3.0.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
