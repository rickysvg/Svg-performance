# Names only for a hosted preview (Vercel + Neon, or a VPS).
# Copy these names into the host's env settings. Do not invent a live URL here.
# Never commit a real password or a live Stripe key.

# Required. Must start with postgresql://  (not file:./dev.db).
DATABASE_URL=

# Required. Long random string (32+ characters).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Required after the first deploy. Paste the real https URL the host gave you.
# Password-reset email uses this. Localhost is ignored in production.
# Example shape only — do not use this as a real address:
# APP_URL=https://your-project.vercel.app
APP_URL=

# Optional. Without SMTP_HOST, production does not offer self-serve password
# reset (no link is shown; every email gets the same message).
# Gymdesk email confirmation codes use these same SMTP_* names.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public support inbox shown on Privacy, Terms, and locked-account data requests.
# Not the gym front desk. Empty falls back to support@svg-performance.app.
SUPPORT_EMAIL=

# Optional. Comma-separated emails allowed to review form checks (plus role=admin).
ADMIN_EMAILS=

# Gymdesk member verify (read-only ingest). App still deploys if these are empty.
# Webhook URLs: APP_URL, else https://${VERCEL_PROJECT_PRODUCTION_URL}, else
# https://svg-performance.vercel.app. Never localhost in production.
GYMDESK_WEBHOOK_SECRET=
GYMDESK_MATCH_PEPPER=
GYMDESK_SYNC_ENABLED=
GYMDESK_GRACE_DAYS=7
GYMDESK_FROZEN_GRACE_DAYS=30
GYMDESK_STALE_DAYS=35
CRON_SECRET=

# Optional. Vercel Blob read/write token. Required on Vercel so form-check videos
# persist and stay private. Without it, upload tells the athlete to set this.
BLOB_READ_WRITE_TOKEN=

# Coach speech, read-aloud, and voice samples. Off unless this is 1 or true
# at build time. Leave empty. Text chat and the written summary stay on.
NEXT_PUBLIC_COACH_VOICE=

# Production only: sk_live_ or rk_live_ (restricted key preferred). Preview must stay on test keys.
# The app rejects live keys unless VERCEL_ENV=production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Portal configuration id. Dashboard default is used when this is empty.
# Required portal features: payment_method_update, invoice_history,
# subscription_cancel mode at_period_end, subscription_update off.
STRIPE_PORTAL_CONFIG_ID=
# Pro $9.99/mo, Pro $72.99/yr, VIP Coaching $249/mo. The app does not create these prices.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_VIP_MONTHLY=
# VIP Coaching coupons. TEST ids only. Empty = no Stripe call and no discount.
# STRIPE_PRICE_COACHING_MONTHLY is the legacy alias for STRIPE_PRICE_VIP_MONTHLY.
# STRIPE_COUPON_VIP_ACADEMY_INTRO = once coupon, $100 off (first month $149, then $249).
# STRIPE_COUPON_VIP_PRO_CREDIT = once coupon for a $30 Pro credit. Used only at exactly $30.
# STRIPE_COUPON_VIP_CREDIT_<cents> = optional exact-cents once coupon (example: STRIPE_COUPON_VIP_CREDIT_999).
# STRIPE_VIP_PRORATION=1 only when unused Pro is already within $30. Leave empty for the no-op.
STRIPE_PRICE_COACHING_MONTHLY=
STRIPE_COUPON_VIP_ACADEMY_INTRO=
STRIPE_COUPON_VIP_PRO_CREDIT=
STRIPE_VIP_PRORATION=
STRIPE_PRICE_STANDALONE=
# Optional TEST stubs for prepaid SKUs (inactive until billing is live)
# STRIPE_PRICE_PERFORMANCE_ANNUAL_GYM=
# STRIPE_PRICE_PERFORMANCE_ANNUAL_NON=
# STRIPE_PRICE_CONDITIONING_CAMP_GYM=
# STRIPE_PRICE_CONDITIONING_CAMP_NON=
# STRIPE_PRICE_CONDITIONING_ANNUAL_GYM=
# STRIPE_PRICE_CONDITIONING_ANNUAL_NON=
# STRIPE_PRICE_DEVELOPMENT_3MO_GYM=
# STRIPE_PRICE_DEVELOPMENT_3MO_NON=
# STRIPE_PRICE_DEVELOPMENT_6MO_GYM=
# STRIPE_PRICE_DEVELOPMENT_6MO_NON=
# STRIPE_PRICE_ELITE_3MO_GYM=
# STRIPE_PRICE_ELITE_3MO_NON=
# STRIPE_PRICE_ELITE_6MO_GYM=
# STRIPE_PRICE_ELITE_6MO_NON=
