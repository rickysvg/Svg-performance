# Names only for a hosted preview (Vercel + Neon, or a VPS).
# Copy these names into the host's env settings. Do not invent a live URL here.
# Never commit a real password or a live Stripe key.

# Required. Must start with postgresql://  (not file:./dev.db).
DATABASE_URL=

# Required. Long random string (32+ characters).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Required after the first deploy. Paste the real https URL the host gave you.
# Password-reset email uses this. Localhost is ignored in production.
# Example shape only — do not use this as a real address:
# APP_URL=https://your-project.vercel.app
APP_URL=

# Optional. Without SMTP_HOST, production does not offer self-serve password
# reset (no link is shown; every email gets the same message).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Comma-separated emails allowed to review form checks (plus role=admin).
ADMIN_EMAILS=

# Gymdesk member verify (read-only ingest). App still deploys if these are empty.
GYMDESK_WEBHOOK_SECRET=
GYMDESK_MATCH_PEPPER=
GYMDESK_SYNC_ENABLED=
GYMDESK_GRACE_DAYS=7
GYMDESK_FROZEN_GRACE_DAYS=30
GYMDESK_STALE_DAYS=35
CRON_SECRET=

# Optional. Vercel Blob read/write token. Required on Vercel so form-check videos
# persist and stay private. Without it, upload tells the athlete to set this.
BLOB_READ_WRITE_TOKEN=

# Stripe TEST only. Leave empty for a view-only preview. Never sk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDALONE=
# Optional TEST stubs for prepaid / founding SKUs (inactive until billing is live)
# STRIPE_PRICE_PERFORMANCE_ANNUAL_GYM=
# STRIPE_PRICE_PERFORMANCE_ANNUAL_NON=
# STRIPE_PRICE_PERFORMANCE_FOUNDING_GYM=
# STRIPE_PRICE_PERFORMANCE_FOUNDING_NON=
# STRIPE_PRICE_CONDITIONING_CAMP_GYM=
# STRIPE_PRICE_CONDITIONING_CAMP_NON=
# STRIPE_PRICE_CONDITIONING_ANNUAL_GYM=
# STRIPE_PRICE_CONDITIONING_ANNUAL_NON=
# STRIPE_PRICE_CONDITIONING_FOUNDING_GYM=
# STRIPE_PRICE_CONDITIONING_FOUNDING_NON=
# STRIPE_PRICE_DEVELOPMENT_3MO_GYM=
# STRIPE_PRICE_DEVELOPMENT_3MO_NON=
# STRIPE_PRICE_DEVELOPMENT_6MO_GYM=
# STRIPE_PRICE_DEVELOPMENT_6MO_NON=
# STRIPE_PRICE_ELITE_3MO_GYM=
# STRIPE_PRICE_ELITE_3MO_NON=
# STRIPE_PRICE_ELITE_6MO_GYM=
# STRIPE_PRICE_ELITE_6MO_NON=
