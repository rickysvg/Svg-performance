# Copy this file to .env and fill in values. Never commit secrets.
# Laptop (default): SQLite file next to prisma/
# DATABASE_URL="file:./dev.db"
# Hosted (Neon or Vercel Postgres): a string that starts with postgresql://
# Never commit a real password. SQLite file: URLs do not work on Vercel.
DATABASE_URL=

# Random string used to hash session and reset tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public URL of this app. Used to build password-reset links.
APP_URL=

# Optional. Production never shows a reset link on screen.
# If these are set (and APP_URL is https), the reset link is emailed.
# If they are empty in production, self-serve reset stays off and every
# address gets the same message. Local development can still show a link.
# Reminders stay in-app on Home unless SMTP_HOST is set.
# Email confirmation codes for Gymdesk use this same SMTP_* setup.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. If this email already has an account, seed promotes it to admin.
ADMIN_BOOTSTRAP_EMAIL=

# Optional. Comma-separated emails that can review form checks, in addition to
# accounts whose role is already admin. Example: ricky@example.com,coach@example.com
ADMIN_EMAILS=

# Optional. If empty, Coach Savage AI stays in honest DEMO / offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Stripe TEST keys only. Never put live sk_live keys here.
# Without these, checkout stays off and nobody is faked as paid.
# Affirm / Klarna / Afterpay: enable in Stripe Dashboard (TEST payment methods).
# No extra API keys — Checkout uses STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GYM=
STRIPE_PRICE_STANDALONE=
STRIPE_PRICE_PERFORMANCE_ANNUAL_GYM=
STRIPE_PRICE_PERFORMANCE_ANNUAL_NON=
STRIPE_PRICE_PERFORMANCE_FOUNDING_GYM=
STRIPE_PRICE_PERFORMANCE_FOUNDING_NON=
STRIPE_PRICE_CONDITIONING_GYM=
STRIPE_PRICE_CONDITIONING_NON=
STRIPE_PRICE_CONDITIONING_CAMP_GYM=
STRIPE_PRICE_CONDITIONING_CAMP_NON=
STRIPE_PRICE_CONDITIONING_ANNUAL_GYM=
STRIPE_PRICE_CONDITIONING_ANNUAL_NON=
STRIPE_PRICE_CONDITIONING_FOUNDING_GYM=
STRIPE_PRICE_CONDITIONING_FOUNDING_NON=
STRIPE_PRICE_DEVELOPMENT_GYM=
STRIPE_PRICE_DEVELOPMENT_NON=
STRIPE_PRICE_DEVELOPMENT_3MO_GYM=
STRIPE_PRICE_DEVELOPMENT_3MO_NON=
STRIPE_PRICE_DEVELOPMENT_6MO_GYM=
STRIPE_PRICE_DEVELOPMENT_6MO_NON=
STRIPE_PRICE_ELITE_GYM=
STRIPE_PRICE_ELITE_NON=
STRIPE_PRICE_ELITE_3MO_GYM=
STRIPE_PRICE_ELITE_3MO_NON=
STRIPE_PRICE_ELITE_6MO_GYM=
STRIPE_PRICE_ELITE_6MO_NON=
STRIPE_PRICE_VIP=
STRIPE_PRICE_PLATINUM=

# Local folder for progress photos. Default: uploads/progress-photos
# Never commit files from this folder.
PROGRESS_PHOTO_DIR=

# Optional local folders for private training clips and weekly focus uploads.
# TRAINING_CLIP_DIR=
# FOCUS_VIDEO_DIR=

# Form-check clips. Laptop default is uploads/form-checks (private, same idea as
# training clips). On Vercel the disk does not keep files. Set BLOB_READ_WRITE_TOKEN
# from a Vercel Blob store so clips stay private and persist. Without that token,
# hosted uploads fail with a clear message instead of pretending they saved.
# FORM_CHECK_DIR=
# BLOB_READ_WRITE_TOKEN=

# Optional Polar AccessLink (Phase 1). Without these, Connect Polar stays TEST /
# not-configured. Never commit secrets.
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=

# Gymdesk member verify (read-only). The app never writes to Gymdesk.
# Off unless GYMDESK_WEBHOOK_SECRET and GYMDESK_MATCH_PEPPER are set.
# GYMDESK_SYNC_ENABLED=0 forces off even when secrets exist.
# Webhook URL origin: APP_URL, then VERCEL_PROJECT_PRODUCTION_URL, then
# https://svg-performance.vercel.app. Localhost is ignored in production.
GYMDESK_WEBHOOK_SECRET=
GYMDESK_MATCH_PEPPER=
GYMDESK_SYNC_ENABLED=
GYMDESK_GRACE_DAYS=7
GYMDESK_FROZEN_GRACE_DAYS=30
GYMDESK_STALE_DAYS=35
CRON_SECRET=

# Future Apple Health / HealthKit (Phase 2 — not wired):
# APPLE_HEALTH_CLIENT_ID=
# APPLE_HEALTH_CLIENT_SECRET=

# Future S3-compatible storage (not wired in this preview — names only):
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
