# Copy this file to .env and fill in values. Never commit secrets.
# SQLite preview (default for this repo):
DATABASE_URL=

# Random string used to hash session and reset tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public URL of this app. Used to build password-reset links.
APP_URL=

# Optional. If empty, password reset shows a one-time PREVIEW link on screen.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
